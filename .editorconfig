root = true

[*]
charset = utf-8
end_of_line = lf

[*.json]
indent_style = space
indent_size = 4
ij_json_keep_blank_lines_in_code = 1

[*.{kt,kts}]
ktlint_code_style = ktlint_official

# Stonecutter preprocessor directives (//? ...) clash with ktlint comment rules
[client/src/**/*.kt]
ktlint_standard_comment-spacing = disabled
ktlint_standard_comment-wrapping = disabled
ktlint_standard_no-single-line-block-comment = disabled
ktlint_standard_block-comment-initial-star-alignment = disabled
ktlint_standard_no-consecutive-comments = disabled
ktlint_standard_no-empty-file = disabled
